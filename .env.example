# Copy to .env and adjust for local development.
# docker-compose already sets the container-network versions of these
# (service names instead of localhost) - this file is for running a
# single service directly on your host, outside Docker.

REDPANDA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
SYMBOLS=btcusdt,ethusdt,solusdt

RATE_LIMIT_FREE_PER_MIN=30
RATE_LIMIT_PRO_PER_MIN=300
FREE_TIER_DELAY_SECONDS=60
